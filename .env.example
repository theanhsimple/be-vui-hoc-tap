# Copy to .env.local and fill in. Never commit real values.

# Public site URL (auth email links redirect here).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Local values come from `pnpm exec supabase status` (API_URL and
# PUBLISHABLE_KEY / ANON_KEY). The publishable key is designed to be public;
# all data access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The web app does NOT use a service-role / secret key. Do not add one here.

# Set to "true" to expose /design-system in a production build (e.g. preview deploys).
ENABLE_DESIGN_SYSTEM=
