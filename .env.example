# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for auth redirects from Sprint 03).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — not used until Sprint 03. Leave empty for now.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Set to "true" to expose /dev/design-system in a production build (e.g. preview deploys).
ENABLE_DESIGN_SYSTEM=
